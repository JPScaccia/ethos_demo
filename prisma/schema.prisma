
// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


/* ============================================================
   NODE
   ============================================================ */

model Node {
  node_id             String   @id
  node_type           String
  title               String
  description         String?  @db.Text

  grade_min           Int?
  grade_max           Int?

  ethos_month         String?

  authority_level     String?

  instructional_use   String[]

  source_name         String?
  source_locator      String?
  source_url          String?  @db.Text

  provenance_type     String?
  review_status       String?

  display_ready       Boolean  @default(false)

  notes               String?  @db.Text


  /* ----------------------------------------------------------
     RELATIONSHIPS
     ---------------------------------------------------------- */

  outgoing_edges Edge[] @relation("EdgeFromNode")

  incoming_edges Edge[] @relation("EdgeToNode")

  embedding Embedding?


  /* ----------------------------------------------------------
     INDEXES
     ---------------------------------------------------------- */

  @@index([node_type])
  @@index([ethos_month])
  @@index([grade_min, grade_max])
  @@index([authority_level])
  @@index([display_ready])

  @@map("nodes")
}


/* ============================================================
   EDGE
   ============================================================ */

model Edge {
  edge_id               String @id

  from_node              String
  relationship_type      String
  to_node                String

  alignment_strength     Int

  grade                   Int?
  month                   String?

  rationale               String? @db.Text

  source_basis            String? @db.Text

  source_name             String?
  source_locator          String?
  source_url              String? @db.Text

  assertion_authority     String?
  provenance_type         String?
  review_status           String?


  /* ----------------------------------------------------------
     NODE RELATIONS
     ---------------------------------------------------------- */

  from Node
    @relation(
      "EdgeFromNode",
      fields: [from_node],
      references: [node_id],
      onDelete: Cascade
    )

  to Node
    @relation(
      "EdgeToNode",
      fields: [to_node],
      references: [node_id],
      onDelete: Cascade
    )


  /* ----------------------------------------------------------
     INDEXES
     ---------------------------------------------------------- */

  @@index([from_node])
  @@index([to_node])
  @@index([relationship_type])
  @@index([grade])
  @@index([month])
  @@index([alignment_strength])

  @@map("edges")
}


/* ============================================================
   EMBEDDING
   ============================================================ */

model Embedding {
  node_id           String   @id

  /*
   * text-embedding-3-small defaults to 1536 dimensions.
   *
   * pgvector will store the vector directly in PostgreSQL.
   */
  embedding         Unsupported("vector(1536)")

  embedding_model   String

  created_at        DateTime @default(now())


  node Node
    @relation(
      fields: [node_id],
      references: [node_id],
      onDelete: Cascade
    )


  @@index([embedding_model])

  @@map("embeddings")
}


/* ============================================================
   APPLICATION CONFIGURATION SNAPSHOTS
   ============================================================

   lib/config.ts remains the source of truth for application
   behavior.

   This table stores versioned configuration snapshots so that
   production activity can be associated with the exact
   configuration that was active at the time.
   ============================================================ */

model AppConfig {
  config_id          String   @id @default(cuid())

  app_version        String
  data_version       String
  retrieval_version  String

  config_json        Json

  active             Boolean  @default(false)

  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt


  @@index([active])
  @@index([retrieval_version])
  @@index([app_version])

  @@map("app_config")
}


/* ============================================================
   QUERY LOG
   ============================================================ */

model QueryLog {
  query_id                String   @id @default(cuid())

  timestamp               DateTime @default(now())

  query                   String   @db.Text

  grade                   Int

  month                   String?

  intent                  String

  intent_confidence       Float

  safe_to_display         Boolean

  latency_ms              Int?

  retrieval_version       String

  prompt_version          String

  claim_audit_version     String?

  initial_failed          Int      @default(0)

  final_failed            Int      @default(0)

  repair_attempted        Boolean  @default(false)

  session_id              String?


  qa_logs                 QaLog[]

  feedback                Feedback[]


  @@index([timestamp])
  @@index([intent])
  @@index([grade])
  @@index([month])
  @@index([safe_to_display])
  @@index([retrieval_version])
  @@index([session_id])

  @@map("query_logs")
}


/* ============================================================
   QA LOG
   ============================================================ */

model QaLog {
  qa_log_id               String   @id @default(cuid())

  query_id                String

  timestamp               DateTime @default(now())

  stage                   String

  status                  String

  safe_to_display         Boolean?

  issue_count             Int      @default(0)

  unsupported_count       Int      @default(0)

  repaired                Boolean  @default(false)

  /*
   * Stores structured QA information such as:
   *
   * claim audits
   * proposition audits
   * grounding classifications
   * issue descriptions
   *
   * This avoids flattening complex QA objects into many columns.
   */
  details                 Json?


  query_log QueryLog
    @relation(
      fields: [query_id],
      references: [query_id],
      onDelete: Cascade
    )


  @@index([query_id])
  @@index([timestamp])
  @@index([stage])
  @@index([status])

  @@map("qa_logs")
}


/* ============================================================
   TEACHER FEEDBACK
   ============================================================ */

model Feedback {
  feedback_id       String   @id @default(cuid())

  query_id          String

  timestamp         DateTime @default(now())

  rating            String

  comment           String?  @db.Text

  session_id        String?


  query_log QueryLog
    @relation(
      fields: [query_id],
      references: [query_id],
      onDelete: Cascade
    )


  @@index([query_id])
  @@index([timestamp])
  @@index([rating])

  @@map("feedback")
}
